# LLM provider keys. The agent picks the first one available:
#   GEMINI_API_KEY  -> GeminiAdapter   (active path, free tier)
#   ANTHROPIC_API_KEY -> ClaudeAdapter (retained, needs paid access)
#   neither         -> TemplateAdapter (deterministic, offline)
#
# Decisions are identical under all three. Only the wording of the explanation
# changes -- the LLM narrates a decision that has already been made.

# https://aistudio.google.com/apikey
# Put the real value in .env (gitignored), NOT here -- this file is committed.
GEMINI_API_KEY=

ANTHROPIC_API_KEY=
